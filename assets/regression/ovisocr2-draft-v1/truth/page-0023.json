        "top": 0.10,
        "right": 0.53,
        "bottom": 0.15
      },
      "source_order": 2
    },
    {
      "type": "markdown",
      "content": "我们把连接圆锥的顶点和底面圆上一点的线段叫做圆锥的母线。",
      "bbox": {
        "left": 0.23,
        "top": 0.21,
