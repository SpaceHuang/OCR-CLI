{
  "name": "@ocrx/dsh",
  "version": "0.1.0",
  "description": "OvisOCR (ocrx) tools for DeepSeek Harness: offline PDF→Markdown scanning, diagnostics, model queries and a consent-gated model installer.",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ocr",
    "pdf-to-markdown",
    "pdf",
    "ocrx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocrx/OCR-CLI.git",
    "directory": "plugins/ocrx-dsh"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32",
        "darwin"
      ]
    }
  },
  "optionalDependencies": {
    "@ocrx/ocrx-win32-x64": "0.1.0",
    "@ocrx/ocrx-darwin-arm64": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test \"test-dist/test/*.test.js\"",
    "test:unit": "node --test \"test-dist/test/*.test.js\""
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.9.0"
  }
}
